generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Tabla `ias` — misma forma que supabase_tablas_minimo_es.sql
model AiTool {
  id           Int      @id @default(autoincrement()) /// nombre en BD: id
  name         String   @map("nombre")
  provider     String?  @map("proveedor")
  description  String   @map("descripcion")
  category     String   @map("categoria")
  urlApi       String?  @map("url_api")
  /// CHECK: free | basico | pro | empresarial
  requiredPlan String   @default("free") @map("plan_minimo")
  isActive     Boolean  @map("activa")
  createdAt    DateTime @default(now()) @map("fecha_creacion")
  updatedAt    DateTime @updatedAt @map("fecha_actualizacion")

  @@map("ias")
}

/// Tabla `usuarios` — misma forma que supabase_tablas_minimo_es.sql
model User {
  id                   Int      @id @default(autoincrement())
  name                 String   @map("nombre")
  email                String   @unique @map("correo")
  passwordHash         String   @map("hash_contrasena")
  /// CHECK: admin | usuario
  globalRole           String   @default("usuario") @map("rol_global")
  stripeCustomerId     String?  @map("id_cliente_stripe")
  stripeSubscriptionId String? @map("id_suscripcion_stripe")
  /// CHECK: activo | inactivo | moroso
  subscriptionStatus   String   @default("inactivo") @map("estado_suscripcion")
  /// CHECK: NULL o free | basico | pro | empresarial
  planType             String?  @map("tipo_plan")
  isActive             Boolean  @default(true) @map("activo")
  createdAt            DateTime @default(now()) @map("fecha_creacion")
  updatedAt            DateTime @updatedAt @map("fecha_actualizacion")

  contactLeads ContactLead[]
  files        UserFile[]

  @@map("usuarios")
}

/// Archivos subidos por el usuario (metadatos en BD; binario en Supabase Storage)
model UserFile {
  id           String   @id @default(uuid()) @db.Uuid
  userId       Int      @map("usuario_id")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  originalName String   @map("nombre_original")
  mimeType     String   @map("tipo_mime")
  sizeBytes    Int      @map("tamano_bytes")
  storagePath  String   @map("ruta_storage")
  createdAt    DateTime @default(now()) @map("fecha_creacion")

  @@index([userId])
  @@map("archivos_usuario")
}

/// Mensajes del formulario de contacto (FK opcional al usuario autenticado)
model ContactLead {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @map("nombre")
  email     String   @map("correo")
  company   String?  @map("empresa")
  message   String   @map("mensaje")
  source    String   @default("website") @map("origen")
  /// CHECK: nuevo | leido | cerrado
  status    String   @default("nuevo") @map("estado")
  userId    Int?     @map("usuario_id")
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now()) @map("fecha_creacion")
  updatedAt DateTime @updatedAt @map("fecha_actualizacion")

  @@map("contactos")
}
