NODE_ENV="development"
PORT="4000"
API_PREFIX="/api/v1"
# Orígenes permitidos (separados por coma). En dev también se acepta cualquier http://localhost:PUERTO
CORS_ORIGIN="http://localhost:3000,http://localhost:3001"

# Connect to Supabase via connection pooling
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"

# Direct connection to the database. Used for migrations
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# Frontend (URLs de retorno de Stripe Checkout)
FRONTEND_URL="http://localhost:3000"

# Stripe (modo test: https://dashboard.stripe.com/test/apikeys )
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Price IDs de productos en modo test (cada plan de la UI)
STRIPE_PRICE_BASICO=""
STRIPE_PRICE_PRO=""
STRIPE_PRICE_EMPRESARIAL=""

# Demo: permite POST /subscription/mock-activate (desactivar en producción)
MOCK_CHECKOUT_ENABLED="true"

# JWT (mínimo 16 caracteres; no commitear el valor real)
JWT_SECRET="idjflasdfncosadjvwidlsafhaoijpdisjvdoiawnhoads"

# --- IAs (chat /api/v1/chat) — verificar con: npm run ai:verify ---
# 1) Pollinations: imágenes — sin API key
# 2) OpenRouter: marketing — https://openrouter.ai/keys
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="meta-llama/llama-3.1-8b-instruct:free"
# 3) Groq: código — https://console.groq.com/keys
GROQ_API_KEY=""

# --- Archivos (Supabase Storage) — ver docs/FILES_STORAGE.md ---
# URL del proyecto: https://xxxx.supabase.co (Settings → API)
SUPABASE_URL=""
# Service role key (Settings → API → service_role). Solo backend.
SUPABASE_SERVICE_ROLE_KEY=""
# Bucket privado creado en Storage (por defecto user-files)
SUPABASE_STORAGE_BUCKET="user-files"

# Opcional: usuario admin inicial (npm run prisma:seed-admin)
ADMIN_SEED_EMAIL="admin@gmail.com"
ADMIN_SEED_NAME="Samuel"
ADMIN_SEED_PASSWORD="cambiar-por-contraseña-segura"
